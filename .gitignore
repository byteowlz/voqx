/target
**/*.rs.bk
Cargo.lock.bak

# Local voice registry data must never be committed (biometric-sensitive).
/voice-registry/
*.wav
*.flac
*.ogg
*.m4a

# UI build artifacts and dependencies
ui/node_modules/
ui/dist/

# pi agent session-local state
.pi/todos/

# Central trx migration state is machine-local (may contain private absolute paths).
.trx/central
.trx/MIGRATED
.trx/*.migrated-*
